{
  "name": "reta-ui",
  "version": "0.1.0",
  "description": "Reta UI Vue component library.",
  "type": "module",
  "license": "GPL-3.0-only",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./src/index.ts"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./src": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vue-tsc -p tsconfig.build.json",
    "lint": "eslint; prettier --check .",
    "fix": "eslint --fix; prettier --write --list-different .",
    "prepack": "pnpm run build",
    "test": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "animate.css": "^4.1.1",
    "dayjs": "^1.11.19",
    "floating-vue": "^5.2.2",
    "focus-trap": "^8.0.0",
    "lodash": "^4.17.23",
    "markdown-it": "^14.1.1",
    "mime": "^4.1.0",
    "nbt-parser": "^1.0.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.28",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.2",
    "vue-tsc": "^3.2.4",
    "xss": "^1.0.15",
    "yup": "^1.7.1"
  },
  "peerDependencies": {
    "highlight.js": "^11.11.1",
    "highlightjs-snbt": "^0.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.23",
    "@types/markdown-it": "^14.1.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.3.0",
    "highlight.js": "^11.11.1",
    "highlightjs-snbt": "^0.1.4",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
